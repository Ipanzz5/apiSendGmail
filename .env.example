PORT=3000
DEFAULT_PROVIDER=auto

# (OPSIONAL TETAPI SANGAT DIREKOMENDASIKAN UNTUK INBOX GMAIL 100% TERKIRIM TANPA BLOKIR SPAM)
# Contoh Konfigurasi Free Transactional SMTP (Brevo / SendGrid / SMTP2GO / Mailersend):
# Brevo memberikan 300 email/hari GRATIS terkirim 100% ke Inbox Gmail/Yahoo
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=email_registrasi_anda@example.com
# SMTP_PASS=master_key_smtp_brevo
# SMTP_FROM="Temp Mail System <no-reply@domain.com>"
